<%- include('partials/head', { title: 'Page Not Found (404)' }) %>
<%- include('partials/navbar') %>

<main class="flex-1 flex items-center justify-center pt-32 pb-20 px-6">
  <div class="max-w-md w-full text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-red-50 border border-red-200/60 rounded-full text-[11px] font-bold uppercase tracking-wider text-red-600 mb-6 font-mono">
      <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
      <span>Status 404 // Disconnected</span>
    </div>
    <h1 class="text-6xl font-extrabold text-slate-900 tracking-tight mb-4 font-mono">404</h1>
    <h2 class="text-2xl font-bold text-slate-800 mb-4">System node not found.</h2>
    <p class="text-slate-600 text-sm leading-relaxed mb-8">
      The requested endpoint or architecture specification does not exist or has been relocated.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 bg-brand-500 hover:bg-brand-600 text-white font-bold px-6 py-3.5 rounded-md text-xs tracking-tight transition-all duration-200 shadow-brand"
    >
      <i data-lucide="arrow-left" class="w-4 h-4"></i>
      <span>Return to Command Center</span>
    </a>
  </div>
</main>

<%- include('partials/footer') %>
