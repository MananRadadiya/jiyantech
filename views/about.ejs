<%- include('partials/head', { title: 'About JiyanTech — Mission & Craft' }) %>
<%- include('partials/navbar') %>

<main class="flex-1 pt-24 pb-20">
  <!-- Page Hero with 3D AboutVisual -->
  <section class="relative py-16 md:py-24 px-6 lg:px-12 bg-gradient-to-b from-slate-50 via-white to-white border-b border-slate-200/80 overflow-hidden">
    <div class="max-w-7xl mx-auto relative z-10">
      <div class="mb-8">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-xs font-semibold text-slate-600 hover:text-brand-500 transition-colors"
        >
          <i data-lucide="arrow-left" class="w-4 h-4"></i>
          <span>Back to Overview</span>
        </a>
      </div>

      <div class="max-w-2xl">
        <p class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-widest text-brand-500 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-500 ring-4 ring-brand-500/15"></span>
          Who We Are
        </p>
        <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-slate-900 mb-6 leading-tight">
          Engineering products that<br />
          <span class="text-brand-500 font-normal">stand the test of scale.</span>
        </h1>
        <p class="text-slate-600 text-base sm:text-lg leading-relaxed max-w-xl">
          JiyanTech was founded on a simple conviction: software should feel effortless to the people who use it, and rock-solid to the engineers who maintain it.
        </p>
      </div>
    </div>

    <!-- 3D Visual on right -->
    <%- include('partials/visuals/about-visual') %>
  </section>

  <!-- Story Section -->
  <section class="py-20 px-6 lg:px-12 border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5">
        <p class="text-[11px] font-bold uppercase tracking-widest text-brand-600 font-mono mb-3">
          Our Mission
        </p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 leading-tight">
          Bridging visionary ambition with <span className="text-brand-500 font-normal">disciplined craft.</span>
        </h2>
      </div>
      <div class="lg:col-span-7 flex flex-col gap-6 text-slate-600 text-base leading-relaxed">
        <p>
          We are an independent software and digital systems engineering studio headquartered in Hyderabad, partnering globally with high-growth startups, scale-ups, and established enterprises.
        </p>
        <p>
          Rather than functioning as an arms-length agency, we integrate as dedicated technical peers. We design architectures that honor your unit economics, write code that passes the most rigorous security audits, and deploy systems that run without emergency interventions.
        </p>
      </div>
    </div>
  </section>

  <!-- Core Values Grid -->
  <section class="py-20 px-6 lg:px-12 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto">
      <div class="mb-14">
        <p class="text-[11px] font-bold uppercase tracking-widest text-brand-600 font-mono mb-2">
          Guiding Principles
        </p>
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 mb-3">
          The values that guide every pull request.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-8 rounded-2xl bg-white border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-brand-50 flex items-center justify-center mb-6">
              <i data-lucide="layers" class="w-6 h-6 text-brand-500"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">First-Principles Engineering</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
              We solve fundamental problems at their root rather than patching symptoms with superficial layers.
            </p>
          </div>
        </div>

        <div class="p-8 rounded-2xl bg-white border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-brand-50 flex items-center justify-center mb-6">
              <i data-lucide="shield" class="w-6 h-6 text-brand-500"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Architectural Durability</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
              Building for the decade ahead with maintainable, testable, and cloud-resilient systems.
            </p>
          </div>
        </div>

        <div class="p-8 rounded-2xl bg-white border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-brand-50 flex items-center justify-center mb-6">
              <i data-lucide="zap" class="w-6 h-6 text-brand-500"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">High Velocity & Precision</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
              Rapid iteration without compromising craft, security, or codebase health.
            </p>
          </div>
        </div>

        <div class="p-8 rounded-2xl bg-white border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-brand-50 flex items-center justify-center mb-6">
              <i data-lucide="users" class="w-6 h-6 text-brand-500"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Deep Partner Alignment</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
              We act as an integrated extension of your core team, sharing full accountability for outcomes.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Metrics Breakdown Section -->
  <section class="py-20 px-6 lg:px-12 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <% metricsData.forEach(function(metric) { %>
        <div class="p-6 bg-slate-50 border border-slate-200 rounded-xl text-center">
          <strong class="block text-4xl sm:text-5xl font-extrabold text-slate-900 mb-2 font-mono">
            <%= metric.value %><span class="text-brand-500"><%= metric.suffix %></span>
          </strong>
          <span class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
            <%= metric.label %>
          </span>
          <small class="text-[11px] text-slate-500 font-mono">
            <%= metric.subtext %>
          </small>
        </div>
      <% }); %>
    </div>
  </section>

  <!-- Production Tech Stack -->
  <section class="py-20 px-6 lg:px-12 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto">
      <div class="mb-14">
        <p class="text-[11px] font-bold uppercase tracking-widest text-brand-600 font-mono mb-2">
          Technologies
        </p>
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 mb-3">
          Our production technology stack.
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 bg-white border border-slate-200 rounded-xl shadow-sm">
          <h3 class="text-sm font-bold uppercase tracking-wider text-brand-600 font-mono mb-4">Frontend</h3>
          <div class="flex flex-wrap gap-1.5">
            <% ['React', 'Next.js', 'TypeScript', 'TailwindCSS', 'Vite', 'State Machines'].forEach(function(t) { %>
              <span class="text-xs bg-slate-100 text-slate-700 px-2.5 py-1 rounded font-medium"><%= t %></span>
            <% }); %>
          </div>
        </div>

        <div class="p-6 bg-white border border-slate-200 rounded-xl shadow-sm">
          <h3 class="text-sm font-bold uppercase tracking-wider text-brand-600 font-mono mb-4">Backend & APIs</h3>
          <div class="flex flex-wrap gap-1.5">
            <% ['Node.js', 'Express', 'Go', 'Python', 'GraphQL', 'REST', 'PostgreSQL'].forEach(function(t) { %>
              <span class="text-xs bg-slate-100 text-slate-700 px-2.5 py-1 rounded font-medium"><%= t %></span>
            <% }); %>
          </div>
        </div>

        <div class="p-6 bg-white border border-slate-200 rounded-xl shadow-sm">
          <h3 class="text-sm font-bold uppercase tracking-wider text-brand-600 font-mono mb-4">Cloud & Infra</h3>
          <div class="flex flex-wrap gap-1.5">
            <% ['AWS', 'Docker', 'Kubernetes', 'Redis', 'CI/CD Pipelines', 'Serverless'].forEach(function(t) { %>
              <span class="text-xs bg-slate-100 text-slate-700 px-2.5 py-1 rounded font-medium"><%= t %></span>
            <% }); %>
          </div>
        </div>

        <div class="p-6 bg-white border border-slate-200 rounded-xl shadow-sm">
          <h3 class="text-sm font-bold uppercase tracking-wider text-brand-600 font-mono mb-4">Product & Design</h3>
          <div class="flex flex-wrap gap-1.5">
            <% ['Figma', 'Design Systems', 'Micro-Interactions', 'User Testing'].forEach(function(t) { %>
              <span class="text-xs bg-slate-100 text-slate-700 px-2.5 py-1 rounded font-medium"><%= t %></span>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Reusable Call to Action Banner -->
  <%- include('partials/sections/cta-banner', {
    subtitle: 'Ready to build?',
    title: 'Let’s discuss your next engineering milestone.',
    desc: 'Schedule an introductory call with our technical leadership team.',
    buttonText: 'Get in Touch'
  }) %>
</main>

<%- include('partials/footer') %>
