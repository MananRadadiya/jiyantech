<%- include('partials/head', { title: 'Contact JiyanTech — Start a Project' }) %>
<%- include('partials/navbar') %>

<main class="flex-1 pt-24 pb-20">
  <!-- Page Hero with 3D ContactVisual -->
  <section class="relative py-16 md:py-24 px-6 lg:px-12 bg-gradient-to-b from-slate-50 via-white to-white border-b border-slate-200/80 overflow-hidden">
    <div class="max-w-7xl mx-auto relative z-10">
      <div class="mb-8">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-xs font-semibold text-slate-600 hover:text-brand-500 transition-colors"
        >
          <i data-lucide="arrow-left" class="w-4 h-4"></i>
          <span>Back to Overview</span>
        </a>
      </div>

      <div class="max-w-2xl">
        <p class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-widest text-brand-500 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-500 ring-4 ring-brand-500/15"></span>
          Get in Touch
        </p>
        <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-slate-900 mb-6 leading-tight">
          Have something<br />
          <span class="text-brand-500 font-normal">worth building?</span>
        </h1>
        <p class="text-slate-600 text-base sm:text-lg leading-relaxed max-w-xl">
          Tell us about your product vision, timeline, or engineering challenges. We typically review and respond within 24 hours.
        </p>
      </div>
    </div>

    <!-- 3D Visual on right -->
    <%- include('partials/visuals/contact-visual') %>
  </section>

  <!-- Contact Info and Form Grid -->
  <section class="py-20 px-6 lg:px-12 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left Contact Details -->
      <div class="lg:col-span-5 flex flex-col gap-8">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-emerald-50 border border-emerald-200/80 rounded-full text-xs font-semibold text-emerald-700 mb-4">
            <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
            <span>NDA Protected by Default</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4">
            Direct access to senior engineering leadership.
          </h2>
          <p class="text-slate-600 text-sm leading-relaxed">
            Every inquiry is reviewed directly by our technical partners. No sales scripts, no qualification gates.
          </p>
        </div>

        <div class="space-y-4">
          <div class="p-5 bg-white border border-slate-200 rounded-xl shadow-xs flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg bg-brand-50 flex items-center justify-center text-brand-600">
              <i data-lucide="mail" class="w-5 h-5"></i>
            </div>
            <div>
              <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 font-mono">Email Us</span>
              <a href="mailto:hello@jiyantech.com" class="text-sm font-semibold text-slate-900 hover:text-brand-600 transition-colors">
                hello@jiyantech.com
              </a>
            </div>
          </div>

          <div class="p-5 bg-white border border-slate-200 rounded-xl shadow-xs flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg bg-brand-50 flex items-center justify-center text-brand-600">
              <i data-lucide="clock" class="w-5 h-5"></i>
            </div>
            <div>
              <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 font-mono">Response Time</span>
              <span class="text-sm font-semibold text-slate-900">&lt; 24 Hours Guaranteed</span>
            </div>
          </div>

          <div class="p-5 bg-white border border-slate-200 rounded-xl shadow-xs flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg bg-brand-50 flex items-center justify-center text-brand-600">
              <i data-lucide="map-pin" class="w-5 h-5"></i>
            </div>
            <div>
              <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 font-mono">Studio Location</span>
              <span class="text-sm font-semibold text-slate-900">Hyderabad, India · Global Remote</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Interactive Contact Form -->
      <div class="lg:col-span-7 bg-white p-8 sm:p-10 rounded-2xl border border-slate-200 shadow-sm">
        <!-- Success Alert Container (hidden initially) -->
        <div id="form-success-banner" class="hidden mb-6 p-6 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900">
          <div class="flex items-center gap-3">
            <i data-lucide="check-circle-2" class="w-6 h-6 text-emerald-600 shrink-0"></i>
            <div>
              <h3 class="text-base font-bold">Transmission Received</h3>
              <p class="text-xs text-emerald-700 mt-1">Thank you! Our engineering team has received your message and will review it within 24 hours.</p>
            </div>
          </div>
        </div>

        <form id="contact-form" action="/contact" method="POST" class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 font-mono mb-2">
                Your Name *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Ada Lovelace"
                class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-900 focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all"
              />
            </div>

            <div>
              <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 font-mono mb-2">
                Work Email *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="ada@company.com"
                class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-900 focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all"
              />
            </div>
          </div>

          <div>
            <label for="company" class="block text-xs font-bold uppercase tracking-wider text-slate-700 font-mono mb-2">
              Company / Project Name
            </label>
            <input
              type="text"
              id="company"
              name="company"
              placeholder="e.g. Acme Corp or Steath Startup"
              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-900 focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all"
            />
          </div>

          <div>
            <label for="serviceType" class="block text-xs font-bold uppercase tracking-wider text-slate-700 font-mono mb-2">
              Primary Service Needed
            </label>
            <select
              id="serviceType"
              name="serviceType"
              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-900 focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all"
            >
              <option value="Digital Product Engineering">Digital Product Engineering</option>
              <option value="SaaS Development">SaaS Development</option>
              <option value="Product Design & UI/UX">Product Design & UI/UX</option>
              <option value="Backend & API Engineering">Backend & API Engineering</option>
              <option value="Mobile Applications">Mobile Applications</option>
              <option value="Custom Business Software">Custom Business Software</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 font-mono mb-2">
              Approximate Budget
            </label>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
              <% ['Under $25k', '$25k - $50k', '$50k - $100k', '$100k+'].forEach(function(b, idx) { %>
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="budget"
                    value="<%= b %>"
                    <%= idx === 1 ? 'checked' : '' %>
                    class="peer sr-only"
                  />
                  <div class="p-2.5 text-center text-xs font-semibold rounded-lg border border-slate-200 bg-slate-50 text-slate-700 peer-checked:bg-brand-50 peer-checked:border-brand-500 peer-checked:text-brand-700 transition-all hover:bg-white">
                    <%= b %>
                  </div>
                </label>
              <% }); %>
            </div>
          </div>

          <div>
            <label for="message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 font-mono mb-2">
              Project Vision & Scope *
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              placeholder="Tell us about the problem you are solving, technical requirements, or ideal timeline..."
              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-900 focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 outline-none transition-all resize-y"
            ></textarea>
          </div>

          <button
            type="submit"
            id="form-submit-btn"
            class="w-full py-4 bg-brand-500 hover:bg-brand-600 text-white font-bold text-xs uppercase tracking-wider rounded-lg shadow-brand hover:shadow-brand-lg transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer"
          >
            <span id="btn-text">Transmit Technical Request</span>
            <i data-lucide="send" id="btn-icon" class="w-4 h-4"></i>
          </button>
        </form>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
