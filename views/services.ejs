<%- include('partials/head', { title: 'Specialized Capabilities & Engineering' }) %>
<%- include('partials/navbar') %>

<main class="flex-1 pt-24 pb-20">
  <!-- Hero Section with 3D ServicesVisual -->
  <section class="relative py-16 md:py-24 px-6 lg:px-12 bg-gradient-to-b from-slate-50 via-white to-white border-b border-slate-200/80 overflow-hidden">
    <div class="max-w-7xl mx-auto relative z-10">
      <div class="mb-8">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-xs font-semibold text-slate-600 hover:text-brand-500 transition-colors"
        >
          <i data-lucide="arrow-left" class="w-4 h-4"></i>
          <span>Back to Overview</span>
        </a>
      </div>

      <div class="max-w-2xl">
        <p class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-widest text-brand-500 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-500 ring-4 ring-brand-500/15"></span>
          End-to-End Capabilities
        </p>
        <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-slate-900 mb-6 leading-tight">
          Specialized engineering for<br />
          <span class="text-brand-500 font-normal">critical digital products.</span>
        </h1>
        <p class="text-slate-600 text-base sm:text-lg leading-relaxed max-w-xl">
          From early-stage MVPs to high-throughput enterprise platforms, we architect and deliver bespoke software systems with precision and speed.
        </p>
      </div>
    </div>

    <!-- 3D Visual on right -->
    <%- include('partials/visuals/services-visual') %>
  </section>

  <!-- Services In-Depth Grid -->
  <section class="py-20 px-6 lg:px-12 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% 
        var serviceIcons = ['code-2', 'server', 'layout', 'cpu', 'smartphone', 'layers'];
        servicesData.forEach(function(service, index) { 
      %>
        <div
          class="p-8 rounded-2xl border border-slate-200 bg-slate-50/50 hover:bg-white hover:border-slate-300 hover:shadow-lg transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1"
        >
          <div>
            <div class="flex justify-between items-start mb-6">
              <div class="w-12 h-12 rounded-xl bg-white border border-slate-200 flex items-center justify-center shadow-sm">
                <i data-lucide="<%= serviceIcons[index % serviceIcons.length] %>" class="w-6 h-6 text-brand-500"></i>
              </div>
              <span class="font-mono text-xs font-bold text-slate-400">
                <%= service.number %>
              </span>
            </div>

            <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-brand-600 transition-colors">
              <%= service.title %>
            </h3>
            <p class="text-slate-600 text-sm leading-relaxed mb-6">
              <%= service.description %>
            </p>

            <div class="flex flex-wrap gap-1.5 mb-8">
              <% service.tags.forEach(function(tag) { %>
                <span class="inline-flex items-center gap-1 text-[11px] font-medium text-slate-700 bg-white border border-slate-200 px-2.5 py-1 rounded">
                  <i data-lucide="check-circle-2" class="w-3 h-3 text-brand-500"></i>
                  <%= tag %>
                </span>
              <% }); %>
            </div>
          </div>

          <div class="pt-4 border-t border-slate-200/60 flex items-center justify-between">
            <span class="text-[10px] font-bold uppercase font-mono tracking-wider text-brand-600">
              <%= service.highlight %>
            </span>
            <a
              href="/contact"
              class="inline-flex items-center gap-1 text-xs font-bold text-slate-700 group-hover:text-brand-600 transition-colors"
            >
              <span>Scope service</span>
              <i data-lucide="arrow-up-right" class="w-3.5 h-3.5"></i>
            </a>
          </div>
        </div>
      <% }); %>
    </div>
  </section>

  <!-- Delivery Framework -->
  <section class="py-20 px-6 lg:px-12 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto">
      <div class="mb-14">
        <p class="text-[11px] font-bold uppercase tracking-widest text-brand-600 font-mono mb-2">
          How We Deliver
        </p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 mb-3">
          The engineering lifecycle.
        </h2>
        <p class="text-slate-500 text-sm max-w-xl">
          Every build follows a structured, transparent cadence with daily asynchronous updates and weekly demonstrable milestones.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 bg-white border border-slate-200 rounded-xl shadow-sm">
          <span class="block font-mono text-2xl font-bold text-brand-500 mb-4">01</span>
          <h3 class="text-base font-bold text-slate-900 mb-2">Discovery & Product Architecture</h3>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
            We unpack business goals, map data domains, establish API contracts, and draft wireframe interaction models.
          </p>
        </div>
        <div class="p-6 bg-white border border-slate-200 rounded-xl shadow-sm">
          <span class="block font-mono text-2xl font-bold text-brand-500 mb-4">02</span>
          <h3 class="text-base font-bold text-slate-900 mb-2">Design Systems & Prototyping</h3>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
            Crafting tokenized component libraries, high-fidelity UI states, and responsive interface workflows.
          </p>
        </div>
        <div class="p-6 bg-white border border-slate-200 rounded-xl shadow-sm">
          <span class="block font-mono text-2xl font-bold text-brand-500 mb-4">03</span>
          <h3 class="text-base font-bold text-slate-900 mb-2">Engineering Sprints & CI/CD</h3>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
            Writing typed, modular code with test-driven workflows, automated deployment pipelines, and security checks.
          </p>
        </div>
        <div class="p-6 bg-white border border-slate-200 rounded-xl shadow-sm">
          <span class="block font-mono text-2xl font-bold text-brand-500 mb-4">04</span>
          <h3 class="text-base font-bold text-slate-900 mb-2">Observability & Global Scaling</h3>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
            Continuous monitoring, sub-50ms latency tuning, load testing, and zero-downtime release orchestration.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Reusable Call to Action Banner -->
  <%- include('partials/sections/cta-banner', {
    subtitle: 'Custom Requirements?',
    title: 'Let’s tailor a dedicated squad for your project.',
    desc: 'Whether you need a full team or specialized domain engineers, we can onboard within days.',
    buttonText: 'Schedule Technical Consultation'
  }) %>
</main>

<%- include('partials/footer') %>
