<section class="py-24 md:py-32 px-6 lg:px-12 bg-slate-50 border-b border-slate-200" id="work">
  <div class="max-w-7xl mx-auto">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div>
        <p class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-widest text-brand-600 font-mono mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
          Selected Work
        </p>
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-slate-900 leading-tight">
          Built for impact,<br />
          <span class="text-brand-500 font-normal">not applause.</span>
        </h2>
      </div>
      <div>
        <a
          class="inline-flex items-center gap-2 text-xs font-bold text-slate-700 hover:text-brand-500 transition-colors"
          href="/work"
        >
          <span>Explore all case studies</span>
          <i data-lucide="arrow-up-right" class="w-3.5 h-3.5"></i>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      <!-- Project 1: Data Analytics Platform -->
      <% var analyticsProject = projectsData[0]; %>
      <article class="lg:col-span-7 bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group hover:-translate-y-1">
        <div class="p-6 sm:p-8 bg-[#0b1528] text-white flex flex-col justify-between relative overflow-hidden h-72 sm:h-80">
          <div class="absolute -right-16 -top-16 w-64 h-64 rounded-full bg-brand-500/20 blur-2xl"></div>

          <div class="flex justify-between items-center relative z-10">
            <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest text-brand-300">
              <i data-lucide="activity" class="w-3 h-3"></i> performance / overview
            </span>
            <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-wider text-emerald-400">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              live
            </span>
          </div>

          <div class="relative z-10 flex justify-between items-end mt-4">
            <span class="text-xs text-slate-300">Growth over time</span>
            <strong class="inline-flex items-center gap-1 text-xs text-emerald-400 font-bold">
              <i data-lucide="trending-up" class="w-3.5 h-3.5"></i> <%= analyticsProject.growth %>
            </strong>
          </div>

          <!-- Chart SVG -->
          <div class="relative h-28 mt-2">
            <svg viewBox="0 0 600 170" preserveAspectRatio="none" class="w-full h-full">
              <path
                d="M0 150 C60 145 67 116 120 125 S160 87 215 105 S255 58 310 82 S360 40 412 59 S464 30 505 42 S550 10 600 15"
                fill="none"
                stroke="#38bdf8"
                stroke-width="3"
                class="chart-path-anim"
              ></path>
            </svg>
          </div>

          <!-- Bottom Metrics Bar -->
          <div class="flex gap-6 pt-3 border-t border-white/10 relative z-10">
            <% analyticsProject.metrics.forEach(function(m) { %>
              <div class="flex flex-col">
                <span class="text-[9px] uppercase font-mono tracking-wider text-slate-400">
                  <%= m.label %>
                </span>
                <b class="text-xs font-mono text-white"><%= m.value %></b>
              </div>
            <% }); %>
          </div>
        </div>

        <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between relative">
          <div>
            <div class="flex justify-between items-center mb-2">
              <span class="text-[10px] uppercase font-bold tracking-widest text-brand-600 font-mono">
                <%= analyticsProject.category %>
              </span>
              <div class="flex gap-1.5">
                <% analyticsProject.tags.slice(0, 3).forEach(function(t) { %>
                  <span class="text-[10px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded">
                    <%= t %>
                  </span>
                <% }); %>
              </div>
            </div>
            <h3 class="text-xl sm:text-2xl font-bold text-slate-900 mb-2">
              Making meaningful data easier to act on.
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              <%= analyticsProject.description %>
            </p>
          </div>

          <div class="mt-4 flex justify-end">
            <a href="/work" class="p-2 rounded-full bg-brand-50 text-brand-600 group-hover:bg-brand-500 group-hover:text-white transition-colors duration-200">
              <i data-lucide="move-up-right" class="w-4 h-4"></i>
            </a>
          </div>
        </div>
      </article>

      <!-- Project 2: Cloud Infrastructure & API Core -->
      <% var architectureProject = projectsData[1]; %>
      <article class="lg:col-span-5 bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group hover:-translate-y-1">
        <div class="p-6 sm:p-8 bg-gradient-to-br from-blue-50 via-white to-blue-100/50 flex items-center justify-center relative overflow-hidden h-72 sm:h-80 border-b border-slate-100">
          <div class="w-4/5 h-4/5 bg-white/90 border border-blue-200 rounded-xl p-4 relative shadow-sm">
            <div class="flex justify-between items-center text-[9px] font-mono text-brand-600">
              <span>API / CORE</span>
              <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
            </div>
            <div class="absolute top-[30%] left-[12%] w-[28%] h-8 bg-blue-50 border border-blue-300 text-brand-700 text-[10px] font-mono font-bold flex items-center justify-center rounded">
              AUTH
            </div>
            <div class="absolute top-[55%] left-[36%] w-[28%] h-8 bg-blue-50 border border-blue-300 text-brand-700 text-[10px] font-mono font-bold flex items-center justify-center rounded">
              DATA
            </div>
            <div class="absolute top-[30%] right-[12%] w-[28%] h-8 bg-blue-50 border border-blue-300 text-brand-700 text-[10px] font-mono font-bold flex items-center justify-center rounded">
              EDGE
            </div>
          </div>
        </div>

        <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between relative">
          <div>
            <div class="flex justify-between items-center mb-2">
              <span class="text-[10px] uppercase font-bold tracking-widest text-brand-600 font-mono">
                <%= architectureProject.category %>
              </span>
              <div class="flex gap-1.5">
                <% architectureProject.tags.slice(0, 2).forEach(function(t) { %>
                  <span class="text-[10px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded">
                    <%= t %>
                  </span>
                <% }); %>
              </div>
            </div>
            <h3 class="text-xl sm:text-2xl font-bold text-slate-900 mb-2">
              The quiet infrastructure behind big ideas.
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              <%= architectureProject.description %>
            </p>
          </div>

          <div class="mt-4 flex justify-end">
            <a href="/work" class="p-2 rounded-full bg-brand-50 text-brand-600 group-hover:bg-brand-500 group-hover:text-white transition-colors duration-200">
              <i data-lucide="move-up-right" class="w-4 h-4"></i>
            </a>
          </div>
        </div>
      </article>
    </div>

    <!-- Note on work -->
    <div class="mt-16 pt-8 border-t border-slate-200 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <span class="text-[11px] font-bold uppercase tracking-widest text-brand-600 font-mono">
        A Note On Our Work
      </span>
      <p class="text-slate-700 text-base sm:text-lg max-w-2xl font-medium">
        We don’t collect logos. We build the systems that make ambitious work possible — with the teams who trust us to get it right.
      </p>
    </div>
  </div>
</section>
