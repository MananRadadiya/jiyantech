<div
  class="hidden lg:block absolute w-[40vw] max-w-[560px] aspect-square right-2 top-1/2 -translate-y-1/2 opacity-95 pointer-events-none select-none"
  aria-hidden="true"
>
  <!-- Blue / Emerald ambient aura -->
  <div class="absolute inset-[15%] rounded-full bg-brand-500/15 blur-3xl animate-pulse-ring"></div>

  <!-- Rotating dashed orbit rings -->
  <div class="absolute inset-4 rounded-full border-2 border-dashed border-brand-500/20 animate-spin-slow"></div>
  <div class="absolute inset-12 rounded-full border border-dashed border-cyan-400/20 animate-spin-reverse"></div>

  <!-- Radar Radiating Beacon Waves -->
  <div class="absolute inset-8 rounded-full border border-brand-500/30 animate-beacon"></div>
  <div class="absolute inset-16 rounded-full border border-cyan-400/30 animate-beacon [animation-delay:0.8s]"></div>
  <div class="absolute inset-24 rounded-full border border-brand-300/30 animate-beacon [animation-delay:1.6s]"></div>

  <!-- Orbiting dots on outer ring -->
  <div class="absolute inset-4 animate-spin-slow">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-brand-500 shadow-lg shadow-brand-500/50"></div>
  </div>
  <div class="absolute inset-12 animate-spin-reverse">
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-2.5 h-2.5 rounded-full bg-cyan-400 shadow-lg shadow-cyan-400/50"></div>
  </div>

  <!-- Center Holographic Dispatch Terminal -->
  <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-60 h-60 animate-float">
    <div class="w-full h-full rounded-2xl bg-white/85 border border-slate-200/90 shadow-2xl p-5 flex flex-col justify-between backdrop-blur-md">
      <!-- Header -->
      <div class="flex justify-between items-center pb-2 border-b border-slate-100">
        <span class="font-mono text-[9px] font-bold text-slate-700 flex items-center gap-1.5">
          <i data-lucide="shield-check" class="w-3 h-3 text-emerald-500"></i>
          TRANSMISSION BEACON
        </span>
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      </div>

      <!-- Central Glowing Icon -->
      <div class="flex flex-col items-center justify-center my-2">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-brand-500 to-blue-600 flex items-center justify-center text-white shadow-brand animate-pulse">
          <i data-lucide="send" class="w-6 h-6"></i>
        </div>
        <span class="text-[10px] font-mono font-bold text-slate-800 mt-2">
          DISPATCH CHANNEL READY
        </span>
      </div>

      <!-- Bottom Indicators -->
      <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-100 text-center">
        <div class="p-1.5 bg-slate-50 rounded">
          <span class="block text-[8px] font-mono text-slate-400">RESPONSE SLA</span>
          <strong class="text-[10px] font-mono text-brand-600 font-bold">&lt; 24 HOURS</strong>
        </div>
        <div class="p-1.5 bg-slate-50 rounded">
          <span class="block text-[8px] font-mono text-slate-400">ENCRYPTION</span>
          <strong class="text-[10px] font-mono text-emerald-600 font-bold">SHA-256</strong>
        </div>
      </div>
    </div>
  </div>

  <!-- Floating Badges -->
  <div class="absolute top-[20%] left-[10%] px-3 py-1.5 rounded-xl bg-white/95 border border-brand-200 shadow-md text-[10px] font-mono text-brand-700 flex items-center gap-2 backdrop-blur-sm animate-float-slow">
    <i data-lucide="mail" class="w-3 h-3 text-brand-500"></i>
    <span>DIRECT PIPELINE</span>
  </div>

  <div class="absolute bottom-[20%] right-[10%] px-3 py-1.5 rounded-xl bg-white/95 border border-emerald-200 shadow-md text-[10px] font-mono text-emerald-700 flex items-center gap-2 backdrop-blur-sm animate-float-slow [animation-delay:1.5s]">
    <i data-lucide="clock" class="w-3 h-3 text-emerald-500"></i>
    <span>PRIORITY QUEUE: ACTIVE</span>
  </div>
</div>
