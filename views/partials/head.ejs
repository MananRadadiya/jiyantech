<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — JiyanTech' : 'JiyanTech — We build the digital systems behind what\'s next.' %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'JiyanTech partners with ambitious teams to turn complex ideas into reliable digital products, platforms, and software that move business forward.' %>">
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Compiled Tailwind & Keyframe Animations -->
  <link rel="stylesheet" href="/css/style.css">
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Three.js & GSAP -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
</head>
<body class="bg-white text-[#090d16] font-sans antialiased overflow-x-hidden selection:bg-blue-100 selection:text-blue-900 min-h-screen flex flex-col">
